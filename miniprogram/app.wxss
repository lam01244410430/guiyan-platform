/* Guiyan premium redesign — shared styles.
   Deep pine green #0B3D36, cinnabar red #C8452C, gold #C9A24B,
   warm paper #F7F4EE, ink #1E2A26. Display face: Noto Serif SC. */
page { background: #F7F4EE; color: #1E2A26; font-family: "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 28rpx; }
.serif { font-family: "Noto Serif SC", "Songti SC", "STSong", serif; }
.wrap { padding: 24rpx 28rpx 40rpx; }
.topbar { display: flex; align-items: center; justify-content: space-between; padding: 10rpx 0 20rpx; }
.brand { font-size: 44rpx; font-weight: 900; color: #0B3D36; letter-spacing: 4rpx; }
.brand-sub { font-size: 22rpx; color: #6B7683; margin-top: 4rpx; }
.langpick { display: flex; align-items: center; border: 2rpx solid #C9A24B; border-radius: 999rpx; padding: 10rpx 20rpx; background: #FFFFFF; color: #0B3D36; font-size: 26rpx; }
.langpick .arrow { color: #C9A24B; margin-left: 8rpx; font-size: 22rpx; }
.hero { background: #0B3D36; border-radius: 28rpx; padding: 40rpx 32rpx 36rpx; color: #F7F4EE; }
.hero .kicker { color: #C9A24B; font-size: 24rpx; letter-spacing: 6rpx; }
.hero .title { font-size: 52rpx; font-weight: 900; line-height: 1.35; margin: 16rpx 0 12rpx; }
.hero .lead { font-size: 27rpx; line-height: 1.7; color: #D8E4DE; }
.hero .stats { margin-top: 26rpx; padding-top: 22rpx; border-top: 2rpx solid rgba(201,162,75,.45); font-size: 25rpx; color: #E9D9A8; }
.searchrow { display: flex; margin-top: 24rpx; }
.searchrow input { flex: 1; background: #FFFFFF; border-radius: 999rpx 0 0 999rpx; padding: 18rpx 28rpx; font-size: 28rpx; }
.searchrow .go { background: #C8452C; color: #FFFFFF; border-radius: 0 999rpx 999rpx 0; padding: 18rpx 30rpx; font-size: 28rpx; font-weight: 700; }
.section { margin-top: 36rpx; }
.section h2, .sec-title { font-size: 36rpx; font-weight: 900; color: #0B3D36; }
.sec-sub { font-size: 25rpx; color: #6B7683; margin-top: 6rpx; line-height: 1.6; }
.card { background: #FFFFFF; border-radius: 24rpx; padding: 28rpx; margin-top: 20rpx; box-shadow: 0 4rpx 16rpx rgba(11,61,54,.06); }
.rescard { background: #FFFFFF; border-radius: 24rpx; padding: 26rpx 28rpx; margin-top: 18rpx; box-shadow: 0 4rpx 16rpx rgba(11,61,54,.06); }
.rescard .name { font-size: 32rpx; font-weight: 700; line-height: 1.45; }
.rescard .meta { font-size: 25rpx; color: #6B7683; margin-top: 10rpx; line-height: 1.6; }
.rescard .desc { font-size: 27rpx; color: #3A4642; margin-top: 12rpx; line-height: 1.7; }
.rescard .foot { display: flex; justify-content: space-between; align-items: center; margin-top: 16rpx; }
.price { color: #C8452C; font-size: 34rpx; font-weight: 900; }
.price .unit { font-size: 24rpx; color: #6B7683; font-weight: 400; margin-left: 6rpx; }
.views { font-size: 24rpx; color: #8A94A6; }
.tag { display: inline-block; background: #EAF2EE; color: #0B3D36; border-radius: 999rpx; padding: 6rpx 16rpx; font-size: 23rpx; margin-right: 10rpx; }
.tag.gold { background: #F5EBD2; color: #8A6D1B; }
.tag.red { background: #FBE9E4; color: #C8452C; }
.btn { display: block; text-align: center; background: #C8452C; color: #FFFFFF; border-radius: 999rpx; padding: 22rpx; font-size: 30rpx; font-weight: 700; margin-top: 24rpx; }
.btn.ghost { background: #FFFFFF; color: #0B3D36; border: 2rpx solid #0B3D36; }
.btn.small { display: inline-block; padding: 12rpx 28rpx; font-size: 26rpx; margin-top: 0; }
.btn.disabled { background: #B9C0C9; }
.chiprow { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.chip { background: #FFFFFF; border: 2rpx solid #DCE3DC; border-radius: 999rpx; padding: 12rpx 24rpx; font-size: 26rpx; margin: 0 14rpx 14rpx 0; color: #1E2A26; }
.chip.on { background: #0B3D36; color: #FFFFFF; border-color: #0B3D36; }
.picker { background: #FFFFFF; border: 2rpx solid #DCE3DC; border-radius: 16rpx; padding: 18rpx 22rpx; font-size: 27rpx; margin-top: 16rpx; display: flex; justify-content: space-between; }
.picker .arrow { color: #C9A24B; }
.note { font-size: 24rpx; color: #6B7683; line-height: 1.7; margin-top: 16rpx; }
.simnote { font-size: 24rpx; color: #8A6D1B; background: #F5EBD2; border-radius: 12rpx; padding: 14rpx 18rpx; margin-top: 18rpx; line-height: 1.6; }
.pill { display: inline-block; border-radius: 999rpx; padding: 6rpx 18rpx; font-size: 23rpx; font-weight: 700; }
.pill.pending { background: #F5EBD2; color: #8A6D1B; }
.pill.confirmed { background: #DDEEE8; color: #0B3D36; }
.pill.paid { background: #DDEEE8; color: #0B3D36; }
.pill.completed { background: #0B3D36; color: #FFFFFF; }
.pill.cancelled, .pill.refunded { background: #EDEFF1; color: #6B7683; }
.empty { text-align: center; color: #6B7683; font-size: 27rpx; line-height: 1.8; padding: 60rpx 30rpx; }
.stepper { display: flex; align-items: center; }
.stepper .st-btn { width: 64rpx; height: 64rpx; line-height: 64rpx; text-align: center; background: #EAF2EE; color: #0B3D36; border-radius: 50%; font-size: 36rpx; font-weight: 700; }
.stepper .st-num { width: 90rpx; text-align: center; font-size: 32rpx; font-weight: 700; }
.msg { max-width: 82%; padding: 18rpx 22rpx; border-radius: 20rpx; font-size: 28rpx; line-height: 1.7; margin-top: 16rpx; white-space: pre-wrap; }
.msg.bot { background: #FFFFFF; align-self: flex-start; }
.msg.me { background: #0B3D36; color: #FFFFFF; align-self: flex-end; }
.chatlog { display: flex; flex-direction: column; }
.quickrow { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.ticket { background: #0B3D36; color: #F7F4EE; border-radius: 24rpx; padding: 30rpx; margin-top: 20rpx; }
.ticket .code { font-size: 44rpx; font-weight: 900; letter-spacing: 4rpx; color: #E9D9A8; margin-top: 8rpx; }
.ticket .tmeta { font-size: 26rpx; color: #D8E4DE; margin-top: 10rpx; line-height: 1.7; }
