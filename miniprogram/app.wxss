/* Guiyan premium redesign — shared styles.
   Brand tokens (design-systems/guiyan/, night-theatre):
   pine #0B3D36, pine-soft #EAF2EE, cinnabar #C8452C (max 2 uses/screen),
   gold #C9A24B, gold-ink #8A6D1B, gold-soft #F5EBD2, paper #F7F4EE,
   surface #FFFFFF, ink #1E2A26, ink2 #5D5344 (secondary text, >=4.5:1),
   line #DCE3DC. Flat, no blue, no gradients.
   Spacing rhythm 16/24/32/48rpx; touch targets >= 88rpx. */
page { background: #F7F4EE; color: #1E2A26; font-family: "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 28rpx; }
.serif { font-family: "Noto Serif SC", "Songti SC", "STSong", serif; }
.wrap { padding: 24rpx 28rpx 48rpx; }
.section { margin-top: 48rpx; }
.section h2, .sec-title { font-size: 36rpx; font-weight: 900; color: #0B3D36; }
.sec-sub { font-size: 25rpx; color: #5D5344; margin-top: 6rpx; line-height: 1.6; }
/* Compact brand hero: one title + one true description line. */
.hero { background: #0B3D36; border-radius: 24rpx; padding: 32rpx 32rpx 28rpx; color: #F7F4EE; }
.hero .kicker { color: #C9A24B; font-size: 24rpx; letter-spacing: 6rpx; }
.hero .title { font-size: 52rpx; font-weight: 900; line-height: 1.35; margin: 12rpx 0 8rpx; }
.hero .lead { font-size: 27rpx; line-height: 1.7; color: #D8E4DE; }
.hero .stats { margin-top: 22rpx; padding-top: 18rpx; border-top: 2rpx solid rgba(201,162,75,.45); font-size: 25rpx; color: #E9D9A8; }
/* R1-3 shop theme: banner strip above the hero (hidden when no banner). */
.shop-banner { background: #0B3D36; color: #F7F4EE; border-radius: 16rpx; padding: 18rpx 28rpx; font-size: 27rpx; font-weight: 700; text-align: center; margin-top: 16rpx; }
.searchrow { display: flex; margin-top: 24rpx; }
.searchrow input { flex: 1; min-height: 88rpx; box-sizing: border-box; background: #FFFFFF; border-radius: 16rpx 0 0 16rpx; padding: 18rpx 28rpx; font-size: 28rpx; }
.searchrow .go { background: #C8452C; color: #FFFFFF; border-radius: 0 16rpx 16rpx 0; padding: 18rpx 30rpx; font-size: 28rpx; font-weight: 700; min-height: 88rpx; box-sizing: border-box; display: flex; align-items: center; }
/* Cards: plain tier below, featured tier carries a gold top rule. */
.card { background: #FFFFFF; border-radius: 24rpx; padding: 28rpx; margin-top: 20rpx; box-shadow: 0 4rpx 16rpx rgba(11,61,54,.06); }
.rescard { background: #FFFFFF; border-radius: 24rpx; padding: 26rpx 28rpx; margin-top: 18rpx; box-shadow: 0 4rpx 16rpx rgba(11,61,54,.06); }
.rescard.featured { border-top: 6rpx solid #C9A24B; }
.rescard .name { font-size: 32rpx; font-weight: 700; line-height: 1.45; }
.rescard .meta { font-size: 25rpx; color: #5D5344; margin-top: 10rpx; line-height: 1.6; }
.rescard .desc { font-size: 27rpx; color: #3A4642; margin-top: 12rpx; line-height: 1.7; }
.rescard .foot { display: flex; justify-content: space-between; align-items: center; margin-top: 16rpx; }
.price { color: #C8452C; font-size: 34rpx; font-weight: 900; }
.price .unit { font-size: 24rpx; color: #5D5344; font-weight: 400; margin-left: 6rpx; }
.views { font-size: 24rpx; color: #5D5344; }
/* Tags: exactly 2 kinds — category (pine) and city (gold). */
.tag { display: inline-block; background: #EAF2EE; color: #0B3D36; border-radius: 12rpx; padding: 6rpx 16rpx; font-size: 23rpx; margin-right: 10rpx; }
.tag.gold { background: #F5EBD2; color: #8A6D1B; }
.btn { display: flex; align-items: center; justify-content: center; text-align: center; background: #C8452C; color: #FFFFFF; border-radius: 24rpx; padding: 24rpx; font-size: 30rpx; font-weight: 700; margin-top: 24rpx; min-height: 88rpx; box-sizing: border-box; }
.btn.ghost { background: #FFFFFF; color: #0B3D36; border: 2rpx solid #0B3D36; }
.btn.small { display: inline-flex; padding: 12rpx 28rpx; font-size: 26rpx; margin-top: 0; min-height: 88rpx; }
.btn.disabled { background: #B9C0C9; }
.chiprow { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.chip { background: #FFFFFF; border: 2rpx solid #DCE3DC; border-radius: 16rpx; padding: 20rpx 28rpx; font-size: 26rpx; margin: 0 14rpx 14rpx 0; color: #1E2A26; min-height: 88rpx; box-sizing: border-box; display: inline-flex; align-items: center; }
.chip.on { background: #0B3D36; color: #FFFFFF; border-color: #0B3D36; }
/* Filter row: city + sort pickers share one row, same height. */
.filterrow { display: flex; gap: 16rpx; margin-top: 16rpx; }
.filterrow .picker { flex: 1; margin-top: 0; }
.picker { background: #FFFFFF; border: 2rpx solid #DCE3DC; border-radius: 16rpx; padding: 18rpx 22rpx; font-size: 27rpx; margin-top: 16rpx; display: flex; justify-content: space-between; min-height: 88rpx; box-sizing: border-box; align-items: center; }
.picker .arrow { color: #C9A24B; }
.note { font-size: 24rpx; color: #5D5344; line-height: 1.7; margin-top: 16rpx; }
.pill { display: inline-block; border-radius: 12rpx; padding: 6rpx 18rpx; font-size: 23rpx; font-weight: 700; }
.pill.pending { background: #F5EBD2; color: #8A6D1B; }
.pill.confirmed { background: #DDEEE8; color: #0B3D36; }
.pill.paid { background: #DDEEE8; color: #0B3D36; }
.pill.completed { background: #0B3D36; color: #FFFFFF; }
.pill.cancelled, .pill.refunded { background: #EDEFF1; color: #5D5344; }
.empty { text-align: center; color: #5D5344; font-size: 27rpx; line-height: 1.8; padding: 60rpx 30rpx; }
.stepper { display: flex; align-items: center; }
.stepper .st-btn { width: 88rpx; height: 88rpx; line-height: 88rpx; text-align: center; background: #EAF2EE; color: #0B3D36; border-radius: 16rpx; font-size: 36rpx; font-weight: 700; }
.stepper .st-num { width: 90rpx; text-align: center; font-size: 32rpx; font-weight: 700; }
/* Vector icons (SVG files in assets/): one family, one stroke. */
.fav-ic { width: 36rpx; height: 36rpx; margin-right: 10rpx; }
.favbtn { display: inline-flex; align-items: center; }
.msg { max-width: 82%; padding: 18rpx 22rpx; border-radius: 20rpx; font-size: 28rpx; line-height: 1.7; margin-top: 16rpx; white-space: pre-wrap; }
.msg.bot { background: #FFFFFF; align-self: flex-start; }
.msg.me { background: #0B3D36; color: #FFFFFF; align-self: flex-end; }
.chatlog { display: flex; flex-direction: column; padding-bottom: 200rpx; }
.quickrow { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
/* Fixed input bar: stays above the tab bar; the log's bottom padding
   (bar height + safe area) keeps the last message + chips visible. */
.chatbar { position: fixed; left: 0; right: 0; bottom: 0; background: #F7F4EE; border-top: 2rpx solid #DCE3DC; padding: 16rpx 28rpx; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); z-index: 10; }
.chatbar .searchrow { margin-top: 0; }
.ticket { background: #0B3D36; color: #F7F4EE; border-radius: 24rpx; padding: 30rpx; margin-top: 20rpx; }
.ticket .code { font-size: 44rpx; font-weight: 900; letter-spacing: 4rpx; color: #E9D9A8; margin-top: 8rpx; }
.ticket .tmeta { font-size: 26rpx; color: #D8E4DE; margin-top: 10rpx; line-height: 1.7; }
/* Form fields on the brand paper surface. */
.field { background: #F7F4EE; border-radius: 12rpx; padding: 18rpx 22rpx; margin-top: 16rpx; min-height: 88rpx; box-sizing: border-box; }
/* Me rows (pages/me): label left, value/arrow right, 88rpx targets. */
.me-avatar { width: 120rpx; height: 120rpx; border-radius: 50%; flex: none; }
.me-avatar-ph { background: #EAF2EE; color: #0B3D36; font-size: 48rpx; display: flex; align-items: center; justify-content: center; }
.merow { display: flex; align-items: center; justify-content: space-between; background: #FFFFFF; border-radius: 16rpx; padding: 24rpx 28rpx; margin-top: 16rpx; font-size: 28rpx; min-height: 88rpx; box-sizing: border-box; }
.merow .sub { font-size: 25rpx; color: #5D5344; }
