<view class="wrap">
<topbar bind:langchange="onLangChange" />
  <view class="hero">
    <view class="kicker">{{res.cat}} · {{res.city}}</view>
    <view class="title serif">{{res.name}}</view>
    <view class="lead">{{res.desc}}</view>
    <view class="stats">{{res.views}} {{L.viewsUnit}}</view>
  </view>
  <view class="card">
    <view class="foot" style="display:flex;justify-content:space-between;align-items:center">
      <view class="price">{{res.price}}<text class="unit">/ {{res.unit}}</text></view>
      <view class="btn ghost small favbtn" bindtap="toggleFav"><image class="fav-ic" src="{{fav ? '/assets/icon-heart-filled.svg' : '/assets/icon-heart.svg'}}" /><text>{{fav ? L.favOn : L.favOff}}</text></view>
    </view>
    <picker mode="date" value="{{date}}" bindchange="onDate">
      <view class="picker">{{res.catId==='creative' ? L.creativeDateLabel : L.dateLabel}}：{{date || L.datePh}} <text class="arrow">▾</text></view>
    </picker>
    <view style="display:flex;justify-content:space-between;align-items:center;margin-top:24rpx">
      <view>{{L.qtyLabel}}</view>
      <view class="stepper">
        <view class="st-btn" bindtap="qtyMinus">−</view>
        <view class="st-num">{{qty}}</view>
        <view class="st-btn" bindtap="qtyPlus">＋</view>
      </view>
    </view>
    <view style="display:flex;justify-content:space-between;margin-top:24rpx;font-size:30rpx;font-weight:700">
      <view>{{L.totalLabel}}</view><view class="price">{{total}}</view>
    </view>
    <!-- R3-2: optional coupon code, sent with the order. -->
    <input value="{{couponCode}}" maxlength="20" placeholder="{{L.couponCodePh}}" bindinput="onCouponInput" style="margin-top:24rpx;font-size:28rpx;border:2rpx solid #e5ddd0;border-radius:8rpx;padding:16rpx" />
    <view class="btn" bindtap="book">{{L.bookNow}}</view>
    </view>

  <!-- R2-4: linked venue name/address when the resource is staged in one. -->
  <block wx:if="{{res.venue}}">
    <view class="card">
      <view class="sec-title serif" style="font-size:32rpx">{{L.venueTitle}}</view>
      <view class="note">{{res.venue.name}} · {{res.venue.address}}</view>
    </view>
  </block>

  <!-- R6-1: copyright facts from resources.meta (fact fields only —
       never invented; the block hides when none are set). -->
  <block wx:if="{{licRows.length}}">
    <view class="card">
      <view class="sec-title serif" style="font-size:32rpx">{{L.licInfo}}</view>
      <block wx:for="{{licRows}}" wx:key="k">
        <view class="note">{{item.k}}：{{item.v}}</view>
      </block>
    </view>
  </block>

  <!-- R6-2: venue free-day calendar (read-only): occupied days are
       marked; the other days of the month are free. -->
  <block wx:if="{{calDays}}">
    <view class="card">
      <view class="sec-title serif" style="font-size:32rpx">{{L.venueCalendar}}</view>
      <view style="display:flex;justify-content:space-between;align-items:center;margin-top:16rpx">
        <view class="btn ghost small" bindtap="onCalPrev">‹</view>
        <view style="font-weight:700">{{calLabel}}</view>
        <view class="btn ghost small" bindtap="onCalNext">›</view>
      </view>
      <view style="display:flex;flex-wrap:wrap;margin-top:16rpx">
        <block wx:for="{{calWeekdays}}" wx:key="*this"><view style="width:14.28%;text-align:center;font-size:24rpx;color:#999">{{item}}</view></block>
        <block wx:for="{{calDays}}">
          <view wx:if="{{item}}" style="width:14.28%;text-align:center;font-size:28rpx;line-height:64rpx;border-radius:12rpx;background:{{item.occ ? '#f6e3d8' : '#f3ecdf'}};color:{{item.occ ? '#8c2b12' : '#1a1a1a'}}">{{item.d}}</view>
          <view wx:else style="width:14.28%;height:64rpx"></view>
        </block>
      </view>
      <view class="note" style="margin-top:12rpx">● {{L.venueOccupied}} · ○ {{L.venueFree}}</view>
      <block wx:if="{{calOccupied.length}}">
        <view class="note" style="margin-top:8rpx">{{L.venueOccupiedDays}}：</view>
        <block wx:for="{{calOccupied}}" wx:key="date">
          <view class="note">{{item.date}} {{item.titles}}</view>
        </block>
      </block>
    </view>
  </block>

  <!-- R2-1: on-sale performances of the resource's approved shows.
       R2-2: tap a performance, then a ticket type — the total and the
       order follow the tier price. -->
  <block wx:if="{{perfs}}">
    <view class="card">
      <view class="sec-title serif" style="font-size:32rpx">{{L.perfTitle}}</view>
      <block wx:if="{{perfs.length}}">
        <view wx:for="{{perfs}}" wx:key="start_at">
          <view bindtap="onPerfTap" data-id="{{item.id}}" style="display:flex;justify-content:space-between;margin-top:16rpx;font-size:28rpx">
            <text>{{item.start_at}}</text><text style="font-weight:700">{{item.price}}</text><text style="color:#0d6e5f;font-weight:700">{{L.perfOnSale}}</text>
          </view>
          <block wx:if="{{perfSel===item.id}}">
            <view style="font-size:28rpx;font-weight:700;margin-top:16rpx">{{L.tierTitle}}</view>
            <block wx:if="{{item.ticket_types.length}}">
              <view wx:for="{{item.ticket_types}}" wx:for-item="tt" wx:key="id" bindtap="onTierTap" data-id="{{tt.id}}" data-avail="{{tt.available}}" style="display:flex;justify-content:space-between;margin-top:12rpx;font-size:28rpx">
                <text style="{{tierSel===tt.id?'color:#0d6e5f;font-weight:700':''}}">{{tt.name}}</text>
                <block wx:if="{{tt.flash_sale}}"><text style="text-decoration:line-through;color:#999">{{tt.price}}</text><text style="font-weight:700;color:#c0392b">{{tt.salePrice}}</text></block>
                <block wx:else><text style="font-weight:700">{{tt.price}}</text></block>
                <text style="color:#0d6e5f">{{tt.leftText}}</text>
              </view>
            </block>
            <block wx:else>
              <view class="note">{{L.tierEmpty}}</view>
            </block>
            <block wx:if="{{item.ticket_types.length && !tierSel}}">
              <view class="note">{{L.tierPick}}</view>
            </block>
            <!-- R3-3: live flash-sale countdown for the selected tier. -->
            <block wx:if="{{flashLeft}}">
              <view class="note">{{flashLeft}}</view>
            </block>
            <!-- R2-5: tap-to-select seat grid for the performance, when
                 it has seats. With no seats the grid stays hidden. -->
            <block wx:if="{{seatZones && seatZones.length}}">
              <view style="font-size:28rpx;font-weight:700;margin-top:16rpx">{{L.seatPick}}</view>
              <view wx:for="{{seatZones}}" wx:key="name">
                <view wx:if="{{item.name}}" style="font-size:26rpx;font-weight:700;margin-top:12rpx">{{item.name}}</view>
                <view style="display:flex;flex-wrap:wrap;margin-top:8rpx">
                  <view wx:for="{{item.cells}}" wx:key="id" bindtap="onSeatTap" data-id="{{item.id}}" data-status="{{item.status}}" style="width:56rpx;height:56rpx;line-height:56rpx;text-align:center;margin:0 8rpx 8rpx 0;border-radius:8rpx;font-size:22rpx;border:2rpx solid {{item.sel ? '#C9A24B' : '#e5ddd0'}};background:{{item.sel ? '#C9A24B' : '#fff'}};color:{{item.sel ? '#fff' : (item.status==='available' ? '#1a1a1a' : '#999')}};opacity:{{item.status==='available' || item.sel ? 1 : 0.45}}">{{item.label}}</view>
                </view>
              </view>
              <view wx:if="{{seatSel.length}}" class="note">{{seatSelectedText}}</view>
            </block>
            <!-- R2-3: pickup-point picker for the selected performance's
                 show; required (the order is blocked) once a tier is picked. -->
            <block wx:if="{{pickupPoints && pickupPoints.length}}">
              <view style="font-size:28rpx;font-weight:700;margin-top:16rpx">{{L.pickupTitle}}</view>
              <view wx:for="{{pickupPoints}}" wx:key="id" bindtap="onPickupTap" data-id="{{item.id}}" style="display:flex;justify-content:space-between;margin-top:12rpx;font-size:28rpx">
                <text style="{{pickupSel===item.id?'color:#0d6e5f;font-weight:700':''}}">{{item.name}}</text><text>{{item.address}}</text>
              </view>
              <block wx:if="{{!pickupSel}}">
                <view class="note">{{L.pickupPick}}</view>
              </block>
            </block>
          </block>
        </view>
      </block>
      <block wx:else>
        <view class="note">{{L.perfEmpty}}</view>
      </block>
    </view>
  </block>

  <block wx:if="{{order}}">
    <view class="card">
      <view class="sec-title serif" style="font-size:32rpx">{{order.code}}</view>
      <view style="margin-top:14rpx"><text class="pill {{order.status}}">{{order.statusText}}</text></view>
      <view class="note">{{L.flow[0]}} → {{L.flow[1]}} → {{L.flow[2]}} → {{L.flow[3]}}</view>
      <view class="note">{{order.name}} · {{order.date}} · ×{{order.qty}} · {{order.total}}</view>
      <block wx:if="{{order.couponSavedText}}">
        <view class="note">{{order.couponSavedText}}</view>
      </block>
      <block wx:if="{{order.flashSavedText}}">
        <view class="note">{{order.flashSavedText}}</view>
      </block>
      <block wx:if="{{order.pickup}}">
        <view class="note">{{L.pickupTitle}}：{{order.pickup.name}} · {{order.pickup.address}}</view>
      </block>
      <block wx:if="{{order.template}}">
        <view class="note"><text style="display:inline-block;width:20rpx;height:20rpx;background:{{order.template.color}};border-radius:4rpx;margin-right:8rpx"></text>{{order.template.name}}</view>
      </block>
      <block wx:if="{{order.status==='pending'}}">
        <view class="btn" bindtap="act" data-act="confirm">{{L.actConfirm}}</view>
        <view class="btn ghost" bindtap="act" data-act="cancel">{{L.actCancel}}</view>
      </block>
      <block wx:if="{{order.status==='confirmed'}}">
        <view class="btn" bindtap="act" data-act="pay">{{order.payLabel}}（{{L.simPay}}）</view>
        <view class="btn ghost" bindtap="act" data-act="cancel">{{L.actCancel}}</view>
      </block>
      <block wx:if="{{order.status==='paid'}}">
        <view class="btn" bindtap="act" data-act="complete">{{L.actComplete}}</view>
        <view class="btn ghost" bindtap="act" data-act="refund">{{L.actRefund}}</view>
      </block>
      <block wx:if="{{order.status==='completed'}}">
        <view class="note">{{L.doneNote}}</view>
      </block>
    </view>
    <block wx:if="{{order.status==='paid' || order.status==='completed'}}">
      <view class="ticket">
        <view style="font-size:26rpx;color:#C9A24B">{{L.ticketTitle}}</view>
        <view class="code serif">{{order.code}}</view>
        <view class="tmeta">{{order.name}}</view>
        <view class="tmeta">{{order.date}} · ×{{order.qty}} · {{order.total}}</view>
      </view>
      <view class="btn ghost" bindtap="goOrders">{{L.myTickets}}</view>
    </block>
  </block>

    <view class="card">
    </view>
  </block>

  <!-- R7-3: knowledge-graph neighbours — related recommendations with
       their kind label; hidden when the graph has nothing for this show. -->
  <block wx:if="{{kgText}}">
    <view class="card">
      <view class="sec-title serif" style="font-size:32rpx">{{L.kgRelated}}</view>
      <view class="note">{{kgText}}</view>
    </view>
  </block>

  <!-- R6-5: comments — only approved rows are public; the author
       additionally sees their own pending/rejected rows (server-side).
       New comments start pending. -->
  <view class="card">
    <view class="sec-title serif" style="font-size:32rpx">{{L.commentTitle}}</view>
    <block wx:if="{{comments.length}}">
      <view wx:for="{{comments}}" wx:key="id" style="margin-top:16rpx;font-size:28rpx">
        <view><text style="color:#C9A24B;font-weight:700">{{item.rating}} ★</text> <text style="font-weight:700">{{item.user_name}}</text><text wx:if="{{item.status==='pending'}}" style="color:#a97e1c"> · {{L.commentPending}}</text><text wx:if="{{item.status==='rejected'}}" style="color:#999"> · {{L.commentRejected}}</text></view>
        <view style="margin-top:6rpx">{{item.content}}</view>
        <view wx:if="{{item.reply}}" style="margin-top:6rpx;color:#5d5344">{{L.commentReplyLabel}}：{{item.reply}}</view>
      </view>
    </block>
    <view wx:else class="note">{{L.commentEmpty}}</view>
    <block wx:if="{{loggedIn}}">
      <view style="display:flex;justify-content:space-between;align-items:center;margin-top:24rpx">
        <view>{{L.commentRating}}</view>
        <view class="stepper">
          <view class="st-btn" bindtap="onCmtRatingDown">−</view>
          <view class="st-num">{{cmtRating}} ★</view>
          <view class="st-btn" bindtap="onCmtRatingUp">＋</view>
        </view>
      </view>
      <textarea value="{{cmtText}}" maxlength="500" placeholder="{{L.commentPh}}" bindinput="onCmtText" style="margin-top:24rpx;font-size:28rpx;border:2rpx solid #e5ddd0;border-radius:8rpx;padding:16rpx" />
      <view class="btn" bindtap="submitComment">{{L.commentSubmit}}</view>
    </block>
  </view>
</view>
