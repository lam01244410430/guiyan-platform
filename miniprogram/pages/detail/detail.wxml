<view class="wrap">
<topbar bind:langchange="onLangChange" />
  <view class="hero">
    <view class="kicker">{{res.cat}} · {{res.city}}</view>
    <view class="title serif">{{res.name}}</view>
    <view class="lead">{{res.desc}}</view>
    <view class="stats">{{res.views}} {{L.viewsUnit}}</view>
  </view>
  <view class="card">
    <view class="foot" style="display:flex;justify-content:space-between;align-items:center">
      <view class="price">{{res.price}}<text class="unit">/ {{res.unit}}</text></view>
      <view class="btn ghost small favbtn" bindtap="toggleFav"><image class="fav-ic" src="{{fav ? '/assets/icon-heart-filled.svg' : '/assets/icon-heart.svg'}}" /><text>{{fav ? L.favOn : L.favOff}}</text></view>
    </view>
    <picker mode="date" value="{{date}}" bindchange="onDate">
      <view class="picker">{{L.dateLabel}}：{{date || L.datePh}} <text class="arrow">▾</text></view>
    </picker>
    <view style="display:flex;justify-content:space-between;align-items:center;margin-top:24rpx">
      <view>{{L.qtyLabel}}</view>
      <view class="stepper">
        <view class="st-btn" bindtap="qtyMinus">−</view>
        <view class="st-num">{{qty}}</view>
        <view class="st-btn" bindtap="qtyPlus">＋</view>
      </view>
    </view>
    <view style="display:flex;justify-content:space-between;margin-top:24rpx;font-size:30rpx;font-weight:700">
      <view>{{L.totalLabel}}</view><view class="price">{{total}}</view>
    </view>
    <view class="btn" bindtap="book">{{L.bookNow}}</view>
    </view>

  <!-- R2-1: on-sale performances of the resource's approved shows.
       R2-2: tap a performance, then a ticket type — the total and the
       order follow the tier price. -->
  <block wx:if="{{perfs}}">
    <view class="card">
      <view class="sec-title serif" style="font-size:32rpx">{{L.perfTitle}}</view>
      <block wx:if="{{perfs.length}}">
        <view wx:for="{{perfs}}" wx:key="start_at">
          <view bindtap="onPerfTap" data-id="{{item.id}}" style="display:flex;justify-content:space-between;margin-top:16rpx;font-size:28rpx">
            <text>{{item.start_at}}</text><text style="font-weight:700">{{item.price}}</text><text style="color:#0d6e5f;font-weight:700">{{L.perfOnSale}}</text>
          </view>
          <block wx:if="{{perfSel===item.id}}">
            <view style="font-size:28rpx;font-weight:700;margin-top:16rpx">{{L.tierTitle}}</view>
            <block wx:if="{{item.ticket_types.length}}">
              <view wx:for="{{item.ticket_types}}" wx:for-item="tt" wx:key="id" bindtap="onTierTap" data-id="{{tt.id}}" data-avail="{{tt.available}}" style="display:flex;justify-content:space-between;margin-top:12rpx;font-size:28rpx">
                <text style="{{tierSel===tt.id?'color:#0d6e5f;font-weight:700':''}}">{{tt.name}}</text><text style="font-weight:700">{{tt.price}}</text><text style="color:#0d6e5f">{{tt.leftText}}</text>
              </view>
            </block>
            <block wx:else>
              <view class="note">{{L.tierEmpty}}</view>
            </block>
            <block wx:if="{{item.ticket_types.length && !tierSel}}">
              <view class="note">{{L.tierPick}}</view>
            </block>
            <!-- R2-3: pickup-point picker for the selected performance's
                 show; required (the order is blocked) once a tier is picked. -->
            <block wx:if="{{pickupPoints && pickupPoints.length}}">
              <view style="font-size:28rpx;font-weight:700;margin-top:16rpx">{{L.pickupTitle}}</view>
              <view wx:for="{{pickupPoints}}" wx:key="id" bindtap="onPickupTap" data-id="{{item.id}}" style="display:flex;justify-content:space-between;margin-top:12rpx;font-size:28rpx">
                <text style="{{pickupSel===item.id?'color:#0d6e5f;font-weight:700':''}}">{{item.name}}</text><text>{{item.address}}</text>
              </view>
              <block wx:if="{{!pickupSel}}">
                <view class="note">{{L.pickupPick}}</view>
              </block>
            </block>
          </block>
        </view>
      </block>
      <block wx:else>
        <view class="note">{{L.perfEmpty}}</view>
      </block>
    </view>
  </block>

  <block wx:if="{{order}}">
    <view class="card">
      <view class="sec-title serif" style="font-size:32rpx">{{order.code}}</view>
      <view style="margin-top:14rpx"><text class="pill {{order.status}}">{{order.statusText}}</text></view>
      <view class="note">{{L.flow[0]}} → {{L.flow[1]}} → {{L.flow[2]}} → {{L.flow[3]}}</view>
      <view class="note">{{order.name}} · {{order.date}} · ×{{order.qty}} · {{order.total}}</view>
      <block wx:if="{{order.pickup}}">
        <view class="note">{{L.pickupTitle}}：{{order.pickup.name}} · {{order.pickup.address}}</view>
      </block>
      <block wx:if="{{order.template}}">
        <view class="note"><text style="display:inline-block;width:20rpx;height:20rpx;background:{{order.template.color}};border-radius:4rpx;margin-right:8rpx"></text>{{order.template.name}}</view>
      </block>
      <block wx:if="{{order.status==='pending'}}">
        <view class="btn" bindtap="act" data-act="confirm">{{L.actConfirm}}</view>
        <view class="btn ghost" bindtap="act" data-act="cancel">{{L.actCancel}}</view>
      </block>
      <block wx:if="{{order.status==='confirmed'}}">
        <view class="btn" bindtap="act" data-act="pay">{{order.payLabel}}（{{L.simPay}}）</view>
        <view class="btn ghost" bindtap="act" data-act="cancel">{{L.actCancel}}</view>
      </block>
      <block wx:if="{{order.status==='paid'}}">
        <view class="btn" bindtap="act" data-act="complete">{{L.actComplete}}</view>
        <view class="btn ghost" bindtap="act" data-act="refund">{{L.actRefund}}</view>
      </block>
      <block wx:if="{{order.status==='completed'}}">
        <view class="note">{{L.doneNote}}</view>
      </block>
    </view>
    <block wx:if="{{order.status==='paid' || order.status==='completed'}}">
      <view class="ticket">
        <view style="font-size:26rpx;color:#C9A24B">{{L.ticketTitle}}</view>
        <view class="code serif">{{order.code}}</view>
        <view class="tmeta">{{order.name}}</view>
        <view class="tmeta">{{order.date}} · ×{{order.qty}} · {{order.total}}</view>
      </view>
      <view class="btn ghost" bindtap="goOrders">{{L.myTickets}}</view>
    </block>
  </block>
</view>
