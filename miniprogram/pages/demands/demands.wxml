<view class="wrap">
<view class="topbar">
  <view>
    <view class="brand serif">桂演 Guiyan</view>
    <view class="brand-sub">{{L.brandTag}}</view>
  </view>
  <picker mode="selector" range="{{langs}}" value="{{langIdx}}" bindchange="onLangChange">
    <view class="langpick">{{langName}} <text class="arrow">▾</text></view>
  </picker>
</view>
  <view class="sec-title serif">{{L.demTitle}}</view>
  <view class="sec-sub">{{L.demSub}}</view>
  <view class="note">{{L.demNote}}</view>
  <block wx:for="{{demands}}" wx:key="i">
    <view class="rescard" bindtap="toggle" data-i="{{item.i}}">
      <view class="name serif">{{item.title}}</view>
      <view class="desc">{{item.desc}}</view>
      <view class="meta"><text class="tag">{{item.cat}}</text><text class="tag gold">{{item.city}}</text><text class="tag red">{{L.budget}} {{item.budget}}</text></view>
    </view>
    <block wx:if="{{open===item.i}}">
      <view class="card">
        <view class="sec-title serif" style="font-size:30rpx">{{matchTitle}}</view>
        <view class="note">{{matchNote}}</view>
        <block wx:for="{{matches}}" wx:key="idx">
          <view class="rescard" bindtap="goDetail" data-idx="{{item.idx}}">
            <view class="name serif">{{item.name}}</view>
            <view class="foot">
              <view class="price">{{item.price}}<text class="unit">/ {{item.unit}}</text></view>
              <view class="views">{{item.city}} · {{item.views}} {{L.viewsUnit}}</view>
            </view>
          </view>
        </block>
      </view>
    </block>
  </block>
</view>
