<view class="wrap">
<topbar bind:langchange="onLangChange" />
  <view class="sec-title serif">{{L.catTitle}}</view>
  <view class="searchrow">
    <input placeholder="{{L.searchPh}}" value="{{kw}}" bindinput="onKw" confirm-type="search" />
    <view class="go">{{L.searchBtn}}</view>
  </view>
  <view class="chiprow">
    <view class="chip {{catSel==='all'?'on':''}}" bindtap="onCat" data-cat="all">{{L.allChip}}</view>
    <block wx:for="{{cats}}" wx:key="id">
      <view class="chip {{catSel===item.id?'on':''}}" bindtap="onCat" data-cat="{{item.id}}">{{item.name}}</view>
    </block>
  </view>
  <!-- R6-2: library entries (venue / equipment / talent) + talent role
       filter (artist only, once the live catalog has meta to filter). -->
  <view class="chiprow">
    <view class="chip {{catSel==='venue'?'on':''}}" bindtap="onCat" data-cat="venue">{{L.libVenue}}</view>
    <view class="chip {{catSel==='equipment'?'on':''}}" bindtap="onCat" data-cat="equipment">{{L.libEquipment}}</view>
    <view class="chip {{catSel==='artist'?'on':''}}" bindtap="onCat" data-cat="artist">{{L.libTalent}}</view>
  </view>
  <view class="chiprow" wx:if="{{catSel==='artist' && hasMeta}}">
    <view class="chip {{roleSel===''?'on':''}}" bindtap="onRole" data-role="">{{L.allChip}}</view>
    <block wx:for="{{roles}}" wx:key="id">
      <view class="chip {{roleSel===item.id?'on':''}}" bindtap="onRole" data-role="{{item.id}}">{{item.name}}</view>
    </block>
  </view>
  <view class="filterrow">
  <picker mode="selector" range="{{cityNames}}" value="{{cityIdx}}" bindchange="onCity">
    <view class="picker">{{L.cityLabel}}：{{cityNames[cityIdx]}} <text class="arrow">▾</text></view>
  </picker>
  <picker mode="selector" range="{{sortNames}}" value="{{sortIdx}}" bindchange="onSort">
    <view class="picker">{{L.sortLabel}}：{{sortNames[sortIdx]}} <text class="arrow">▾</text></view>
  </picker>
  </view>
  <block wx:if="{{catSel==='copyright'||catSel==='show-license'}}">
    <view class="filterrow">
    <picker mode="selector" range="{{licKindNames}}" value="{{licKindIdx}}" bindchange="onLicKind">
      <view class="picker">{{L.licKind}}：{{licKindNames[licKindIdx]}} <text class="arrow">▾</text></view>
    </picker>
    <picker mode="selector" range="{{licStatusNames}}" value="{{licStatusIdx}}" bindchange="onLicStatus">
      <view class="picker">{{L.licStatus}}：{{licStatusNames[licStatusIdx]}} <text class="arrow">▾</text></view>
    </picker>
    </view>
    <view class="sec-title serif">{{L.licLibrary}}</view>
    <block wx:if="{{licenses.length===0}}">
      <view class="empty">{{L.emptyRes}}</view>
    </block>
    <block wx:for="{{licenses}}" wx:key="id">
      <view class="rescard">
        <view class="name serif">{{item.name}}</view>
        <view class="meta"><text class="tag">{{item.kind}}</text><text class="tag gold">{{item.status}}</text></view>
        <view class="desc">{{item.licensor}} → {{item.licensee}}</view>
        <view class="foot">
          <view class="price">{{item.price}}</view>
          <view class="views">{{item.dates}}</view>
        </view>
      </view>
    </block>
  </block>
  <view class="note">{{resultLine}}</view>
  <block wx:if="{{list.length===0}}">
    <view class="empty">{{L.emptyRes}}</view>
  </block>
  <block wx:for="{{list}}" wx:key="idx">
    <view class="rescard" bindtap="goDetail" data-idx="{{item.idx}}">
      <view class="name serif">{{item.name}}</view>
      <view class="meta"><text class="tag">{{item.cat}}</text><text class="tag gold">{{item.city}}</text></view>
      <view class="desc">{{item.desc}}</view>
      <view class="foot">
        <view class="price">{{item.price}}<text class="unit">/ {{item.unit}}</text></view>
        <view class="views">{{item.views}} {{L.viewsUnit}}</view>
      </view>
      <view class="btn ghost small favbtn" catchtap="toggleFav" data-idx="{{item.idx}}"><image class="fav-ic" src="{{item.fav ? '/assets/icon-heart-filled.svg' : '/assets/icon-heart.svg'}}" /><text>{{item.fav ? L.favOn : L.favOff}}</text></view>
    </view>
  </block>
</view>
