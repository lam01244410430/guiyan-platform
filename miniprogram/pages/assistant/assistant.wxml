<view class="wrap">
<topbar bind:langchange="onLangChange" />
  <view class="sec-title serif">{{L.aiTitle}}</view>
  <view class="sec-sub">{{L.aiSub}}</view>
  <view class="note">{{L.aiNote}}</view>
  <view class="simnote">{{L.simAi}}</view>
  <view class="section">
    <view class="chatlog">
      <block wx:for="{{msgs}}" wx:key="index">
        <view class="msg {{item.who}}">{{item.text}}</view>
      </block>
      <view class="quickrow">
        <block wx:for="{{quicks}}" wx:key="index">
          <view class="chip" bindtap="quick" data-q="{{item}}">{{item}}</view>
        </block>
      </view>
    </view>
  </view>
</view>
<view class="chatbar">
  <view class="searchrow">
    <input placeholder="{{L.chatPh}}" value="{{input}}" bindinput="onInput" confirm-type="send" bindconfirm="send" />
    <view class="go" bindtap="send">{{L.sendBtn}}</view>
  </view>
</view>
