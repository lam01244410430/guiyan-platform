# Guiyan server — copy to .env for local development. Never commit .env.
# PostgreSQL only. Start the database first: docker compose up -d
DATABASE_URL=postgres://guiyan:guiyan@localhost:5432/guiyan
PORT=3001
# Demo accounts (demo / supplier / admin) are seeded on FIRST boot only,
# from these two variables. Set them before the first boot.
# The values are the public demo credentials published in the original
# group docs (guiyan-demo/docs, file 08 运行与最终交付说明).
DEMO_PASSWORD=your-demo-password
ADMIN_PASSWORD=your-admin-password
