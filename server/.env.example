# Guiyan server — copy to .env for local development. Never commit .env.
# PostgreSQL only. Start the database first: docker compose up -d
DATABASE_URL=postgres://guiyan:guiyan@localhost:5432/guiyan
PORT=3001
# Floating AI chat proxy (POST /api/assistant/chat) — trial backend.
# Server-only; never put AI_CHAT_URL in the client bundle.
# AI_CHAT_URL=http://34.96.190.102/api/chat
# AI_CHAT_TIMEOUT_MS=25000
# Demo accounts (demo / supplier / admin) are seeded on FIRST boot only,
# from these two variables. Set them before the first boot.
# The values are the public demo credentials published in the original
# group docs (guiyan-demo/docs, file 08 运行与最终交付说明).
DEMO_PASSWORD=your-demo-password
ADMIN_PASSWORD=your-admin-password
# Object storage (Neon Object Storage, bucket "uploads") — optional.
# Written by `neon deploy` into .env.local; copy the same four values
# here only for local development without the Neon CLI.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=ap-southeast-1
