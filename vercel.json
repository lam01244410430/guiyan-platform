{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "mkdir -p dist dist/admin && cp -r web/. dist/ && cp -r admin/. dist/admin/",
  "framework": "vite",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "outputDirectory": "dist",
  "regions": [
    "sin1"
  ],
  "routes": [
    {
      "dest": "/api/index?route=$1",
      "src": "/api/(.*)"
    },
    {
      "handle": "filesystem"
    },
    {
      "dest": "/index.html",
      "src": "/.*"
    }
  ]
}